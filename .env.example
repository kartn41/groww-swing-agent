# Placeholders only. Real values go in .env (git-ignored, chmod 600). Never commit or paste secrets.
GROWW_MODE=PAPER
GROWW_TOTP_TOKEN=
GROWW_TOTP_SECRET=
# Only needed for LIVE order placement / the live GTT monitor (the static IP whitelisted on Groww)
GROWW_STATIC_IP=
# Starting balance for the paper account
PAPER_CAPITAL=250000
# Telegram: create the bot with @BotFather; get the chat id with `python -m app.run telegram-chatid`
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Dashboard (127.0.0.1 only; view through an SSH tunnel). Password: 8+ characters.
DASHBOARD_PASSWORD=
DASHBOARD_PORT=8501
# Event calendar (data/events/events.csv). true = no new entries if the calendar is missing/stale.
EVENTS_REQUIRED=false
EVENT_BLOCK_DAYS=7
# Optional: URL pinged after each successful daily run (e.g. a healthchecks.io check)
HEARTBEAT_URL=
# Seconds between historical-data requests. Groww does not document a limit for this endpoint, so the default
# is cautious; the fetch slows itself down further after any rate-limit error. Raise it if you still see them.
GROWW_DATA_PACE=0.6
# Stock candles: bhavcopy = NSE's official end-of-day file after GROWW_EQUITY_UNTIL (Groww keeps NIFTY and the
# older stock history); groww = Groww for everything. Groww's stock candles after 2025-10-04 came back mostly empty.
STOCK_SOURCE=bhavcopy
GROWW_EQUITY_UNTIL=2025-10-04
# Seconds between NSE bhavcopy downloads
BHAVCOPY_PACE=1.0
# on = a pullback is bought only on a bounce with at least average volume, after a dip on below-average volume.
# Off by default until replays show it helps.
PULLBACK_VOLUME_GATE=off
# Daily job: retries while today's NIFTY (or, with bhavcopy, stock) candles are not yet available
DAILY_RETRIES=3
DAILY_RETRY_WAIT=600
