[Unit]
Description=groww-swing-agent local dashboard (127.0.0.1 only)
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
User=__USER__
WorkingDirectory=__DIR__
ExecStart=__DIR__/.venv/bin/python -m app.run dashboard
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
