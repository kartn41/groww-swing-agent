[Unit]
Description=groww-swing-agent daily paper run (fetch, catch up, report)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=__DIR__
ExecStart=__DIR__/.venv/bin/python -m app.run daily
TimeoutStartSec=3600
Nice=5
NoNewPrivileges=true
PrivateTmp=true
